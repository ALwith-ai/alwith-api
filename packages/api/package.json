{
  "name": "@alwith/api",
  "version": "0.4.9",
  "description": "ALwith from the app side: the Runtime client, the agents you hold, and ACP session state",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js",
      "default": "./dist/tools.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js",
      "default": "./dist/agent/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js",
      "default": "./dist/session/index.js"
    },
    "./tauri": {
      "types": "./dist/tauri.d.ts",
      "import": "./dist/tauri.js",
      "default": "./dist/tauri.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SESSION.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "rust"
  ],
  "peerDependencies": {
    "@agentclientprotocol/sdk": ">=1.8.0",
    "@tauri-apps/api": ">=2"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "private": false,
  "scripts": {
    "build": "bun ../../scripts/build-npm.ts",
    "prepack": "bun run build"
  },
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALwith-ai/alwith-api.git",
    "directory": "packages/api"
  }
}
